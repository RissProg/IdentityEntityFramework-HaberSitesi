@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityOrnek.Models.AppUser> SignInManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IdentityOrnek</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IdentityOrnek.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Haberler" asp-action="Index">
                    GÜNDEM<span style="color: #e74c3c;">HABER</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* 1. KATEGORİLER: Sadece Admin ve Yazar OLMAYANLAR (Üyeler ve Ziyaretçiler) görsün *@
                        @if (!User.IsInRole("Admin") && !User.IsInRole("Yazar"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Haberler" asp-action="Index"
                                   asp-route-kategori="Ekonomi">EKONOMİ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Haberler" asp-action="Index"
                                   asp-route-kategori="Siyaset">SİYASET</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Haberler" asp-action="Index"
                                   asp-route-kategori="Gundem">GÜNDEM</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Haberler" asp-action="Index"
                                   asp-route-kategori="Magazin">MAGAZİN</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Haberler" asp-action="Index"
                                   asp-route-kategori="Spor">SPOR</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Haberler" asp-action="Index"
                                   asp-route-kategori="Kripto">KRİPTO PARA</a>
                            </li>
                        }

                        @* 2. YÖNETİM MENÜLERİ: Sadece Giriş Yapmış Admin ve Yazarlar görsün *@
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("Yazar"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Haberler" asp-action="Liste">Haber
                                        Yönetimi</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Haberler" asp-action="Ekle">Haber Ekle</a>
                                    </li>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="KullaniciYonetimi"
                                           asp-action="Index">Kullanıcı Yönetimi</a>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-controller="KullaniciYonetimi"
                                               asp-action="OnayBekleyenYorumlar">Yorum Onayları</a>
                                        </li>
                                    }
                                }
                            }
                        </ul>

                        @* 3. KULLANICI GİRİŞ/ÇIKIŞ ALANI *@
                        <ul class="navbar-nav">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <li class="nav-item me-3 d-flex align-items-center">
                                    <span class="text-primary fw-semibold">Hoşgeldin, @User.FindFirst("TamAd")?.Value</span>
                                </li>
                                <li class="nav-item d-flex align-items-center">
                                    <form asp-action="Logout" asp-controller="Account" method="post" class="m-0">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Çıkış Yap</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-success btn-sm" asp-action="Login" asp-controller="Account">Giriş Yap</a>
                                </li>
                            
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted mt-5">
            <div class="container text-center py-3">
                &copy; 2026 - GÜNDEM<span style="color: #e74c3c;">HABER</span> | TÜM HAKLARI SAKLIDIR.
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>