@model List<IdentityOrnek.Models.Yorum>

@{
    ViewData["Title"] = "Onay Bekleyen Yorumlar";
}

<div class="container mt-4">
    <h2>Onay Bekleyen Kullanıcı Yorumları</h2>
    <hr />

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Şu anda onay bekleyen yeni bir yorum bulunmamaktadır.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Kullanıcı</th>
                    <th>Haber Başlığı</th>
                    <th>Yorum İçeriği</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var yorum in Model)
                {
                    <tr>
                        <td>@yorum.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@yorum.AppUser?.UserName</td>
                        <td>
                            @if (yorum.Haber != null)
                            {
                                <a asp-controller="Haberler" asp-action="Detay" asp-route-id="@yorum.HaberId" target="_blank">
                                    @yorum.Haber.Baslik
                                </a>
                            }
                        </td>
                        <td>@yorum.Icerik</td>
                        <td>
                            <div class="d-flex gap-2">
                                <form asp-action="YorumOnayla" method="post">
                                    <input type="hidden" name="id" value="@yorum.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                                </form>

                                <form asp-action="YorumReddet" method="post">
                                    <input type="hidden" name="id" value="@yorum.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Bu yorumu reddedip silmek istediğinize emin misiniz?');">Reddet</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>